# Stream (edge transport). Reuse the SAME values from the parent app's
# .env (STREAM_API_KEY / STREAM_API_SECRET) - this is the same Stream app,
# just accessed from the Python agent instead of the Expo API routes.
STREAM_API_KEY=
STREAM_API_SECRET=

# OpenAI Realtime (voice-only speech-to-speech LLM).
OPENAI_API_KEY=

# Shared secret the Expo backend sends on every request to this service's
# `serve` HTTP API (see lib/server/visionAgent.ts / VISION_AGENT_BASE_URL in
# the parent app's .env). Generate any random string and copy the SAME value
# into both places - requests without it are rejected.
AGENT_SHARED_SECRET=
