EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Clerk secret key (server-only). Used by the Expo API routes under app/api/
# to verify the caller's session - do NOT prefix with EXPO_PUBLIC_.
CLERK_SECRET_KEY=sk_your_clerk_secret_key_here

# Stream (server-only). Used by the Expo API routes to mint user tokens and
# create calls - do NOT prefix with EXPO_PUBLIC_. The client never sees these
# directly; it receives a short-lived token from /api/stream/session instead.
STREAM_API_KEY=your_stream_api_key_here
STREAM_API_SECRET=your_stream_api_secret_here

# The AI teacher itself runs as a separate Python service in vision-agent/.
# Copy these same STREAM_API_KEY/STREAM_API_SECRET values into
# vision-agent/.env (see vision-agent/.env.example) alongside an
# OPENAI_API_KEY for the Realtime voice model.

# Server-only. Used by app/api/agent/{start,stop}+api.ts to proxy to the
# vision-agent service's `serve` HTTP API (`uv run agent.py serve`) - the
# mobile app never talks to it directly. AGENT_SHARED_SECRET must match the
# value in vision-agent/.env.
VISION_AGENT_BASE_URL=http://localhost:8000
AGENT_SHARED_SECRET=your_shared_secret_here

# Optional. Base URL the app should use to reach the Expo API routes from a
# native build (e.g. an EAS Hosting deployment URL). Leave unset in local dev
# - the app falls back to the Metro dev server's own host automatically.
# EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.example.com
